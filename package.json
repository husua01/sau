{
  "name": "sau",
  "private": true,
  "version": "0.1.0",
  "description": "SAU: NFT 소유를 조건으로 콘텐츠 열람을 여는 게이트 — 생성과 동시에 자동 암호화, 복호화 시점에 해당 NFT 보유 필요",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "deploy:localnet": "hardhat run scripts/deploy-unified.ts --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy-unified.ts --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy-unified.ts --network mainnet"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@lit-protocol/auth-helpers": "^6.4.0",
    "@lit-protocol/core": "^6.4.0",
    "@lit-protocol/encryption": "^6.4.0",
    "@lit-protocol/lit-node-client": "^6.4.0",
    "@lit-protocol/types": "^6.4.0",
    "@vercel/blob": "^2.8.0",
    "arweave": "^1.15.7",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.2",
    "@nomicfoundation/hardhat-ignition": "^0.15.13",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.14",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.1",
    "@nomicfoundation/ignition-core": "^0.15.13",
    "@openzeppelin/contracts": "5.0.2",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.11.30",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "chai": "^4.5.0",
    "dotenv": "16.4.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.5",
    "ethers": "^6.15.0",
    "hardhat": "^2.27.0",
    "hardhat-gas-reporter": "^1.0.10",
    "is-symbol": "^1.1.1",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.9.6",
    "solidity-coverage": "0.8.12",
    "ts-node": "10.9.2",
    "typechain": "^8.3.2",
    "typescript": "5.4.5"
  }
}
