# =============================================================================
# SAU Platform 환경 변수 설정 예시 파일
# =============================================================================
# 이 파일을 .env.local로 복사하여 사용하세요:
# cp env.example .env.local
#
# SAU 플랫폼: NFT 생성과 동시에 자동 접근 제어가 설정되는 탈중앙화 콘텐츠 플랫폼
# 모든 값은 실제 값으로 변경해야 합니다. 현재는 예시 값입니다.
# =============================================================================

# =============================================================================
# 🚀 앱 기본 설정 (필수)
# =============================================================================
NODE_ENV="development"
PORT="3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# 🖼️ 이미지 호스팅 설정 (필수 - NFT 이미지용)
# =============================================================================
# Pinata IPFS (권장): https://app.pinata.cloud/
# 무료 플랜: 1GB 스토리지, 월 1000개 파일 업로드
PINATA_API_KEY="YOUR_PINATA_API_KEY"
PINATA_SECRET_KEY="YOUR_PINATA_SECRET_KEY"

# =============================================================================
# ⛓️ Ethereum 블록체인 설정 (필수)
# =============================================================================
# 1. https://www.alchemy.com/ 에서 계정 생성
# 2. 테스트넷/메인넷 앱 생성
# 3. API Key를 복사하여 아래에 입력

# 🌐 네트워크 설정 (testnet 또는 mainnet)
NETWORK_MODE="testnet"

# 테스트넷 설정 (개발/테스트용)
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
NEXT_PUBLIC_CHAIN_ID="11155111"
TESTNET_CHAIN_NAME="Sepolia Testnet"

# 메인넷 설정 (실제 운영용)
MAINNET_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
MAINNET_CHAIN_ID="1"
MAINNET_CHAIN_NAME="Ethereum Mainnet"

# =============================================================================
# 💰 지갑 설정 (필수)
# =============================================================================
# 1. MetaMask에서 새 지갑 생성 또는 기존 지갑 사용
# 2. 지갑 내보내기 > 개인키 복사 (0x로 시작하는 64자리)
# 3. Sepolia 테스트넷에서 테스트 ETH 받기: https://sepoliafaucet.com/

# 배포용 지갑 (컨트랙트 배포, 테스트용)
PRIVATE_KEY="0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef"

# Etherscan API (트랜잭션 확인 및 검증용)
ETHERSCAN_API_KEY="YOUR_ETHERSCAN_API_KEY"

# =============================================================================
# 📦 스마트 컨트랙트 설정 (배포 후 필수)
# =============================================================================
# 1. 컨트랙트 배포: pnpm sau:deploy
# 2. 배포된 컨트랙트 주소를 아래에 입력
# 주의: NEXT_PUBLIC_ 접두사가 있으면 클라이언트에서도 접근 가능
# 주의: 코드에는 더 이상 이 값들에 대한 기본값 폴백이 없습니다. 비어 있으면
#       API/페이지가 명확한 에러를 던지고 조용히 잘못된 주소로 동작하지 않습니다.
SAU_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
NEXT_PUBLIC_SAU_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"

# 컨트랙트가 배포된 블록 번호 (필수 — /api/unified의 NFT 목록 조회가
# 이 블록부터만 이벤트를 스캔하여 RPC 호출 수를 줄인다. `npm run deploy:*`가
# 배포 시 자동으로 이 값을 기록해준다)
SAU_DEPLOYMENT_BLOCK="0"

# =============================================================================
# 🌐 Arweave 영구 저장소 설정 (mainnet만 지원)
# =============================================================================
# 실제 Arweave 사용 시:
# 1. https://arweave.app/ 에서 지갑 생성
# 2. JSON 키 파일 다운로드
# 3. JSON 내용을 한 줄로 압축하여 아래에 입력
#
# 예전에는 testnet.redstone.tools를 기본 testnet 게이트웨이로 사용했으나,
# 이 게이트웨이는 수년 전 종료되어 기본 설정에서 업로드가 항상 실패했다.
# 그래서 mainnet 게이트웨이만 지원하도록 단순화했다.

ARWEAVE_HOST="arweave.net"
ARWEAVE_PORT="443"
ARWEAVE_PROTOCOL="https"
ARWEAVE_KEY="{\"kty\":\"RSA\",\"n\":\"YOUR_REAL_ARWEAVE_KEY\",\"e\":\"AQAB\"}"

# =============================================================================
# 🔐 Lit Protocol 접근 제어 설정 (필수 - NFT 기반 암호화)
# =============================================================================
# Lit Protocol v6 SDK 설정
# 참고: https://developer.litprotocol.com/

# Lit 네트워크 설정
# 이것은 암호화/복호화를 수행하는 Lit Protocol 네트워크입니다
# ⚠️ SDK v6.4.0+ 필수!
# 공식 문서: https://developer.litprotocol.com/connecting-to-a-lit-network/testnets
# 
# 유효한 네트워크:
# - datil-test (권장 - Chronicle Yellowstone, 프로덕션 전 테스트)
# - datil-dev (개발용 - 키 비영구, 무료)
# - datil (프로덕션)
NEXT_PUBLIC_LIT_NETWORK="datil-test"

# Ethereum RPC URL (Lit Protocol이 내부적으로 사용)
# Sepolia RPC와 같은 값
NEXT_PUBLIC_SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# 블록체인 체인 설정 (접근 제어 조건을 확인할 체인)
NEXT_PUBLIC_LIT_CHAIN="sepolia"  # sepolia 또는 ethereum

# =============================================================================
# 📝 Chronicle Yellowstone (Lit Protocol 인프라용 - 자동)
# =============================================================================
# Chronicle Yellowstone은 Lit Protocol의 커스텀 EVM 롤업입니다.
# PKP 민팅 및 권한 관리에 사용됩니다.
# 
# Chain ID: 175188
# RPC URL: https://yellowstone-rpc.litprotocol.com/
# Explorer: https://yellowstone-explorer.litprotocol.com/
# Currency: tstLPX (테스트 토큰)
#
# 주의: 이 설정은 SDK가 자동으로 처리하므로 수동 설정이 필요 없습니다.

# =============================================================================
# 📋 설정 완료 체크리스트
# =============================================================================
# ✅ SEPOLIA_RPC_URL 설정됨
# ✅ PRIVATE_KEY 설정됨 (테스트용 지갑)
# ✅ SAU_CONTRACT_ADDRESS / NEXT_PUBLIC_SAU_CONTRACT_ADDRESS 설정됨 (배포 후)
# ✅ SAU_DEPLOYMENT_BLOCK 설정됨 (배포 후)
# ✅ NEXT_PUBLIC_LIT_NETWORK 설정됨
# ✅ 지갑에 테스트 ETH 충전됨 (0.1 ETH 이상 권장)
#
# =============================================================================
# 🚀 실행 방법 (SAU 플랫폼)
# =============================================================================
# 1. 개발 서버: npm run dev
# 2. 컨트랙트 컴파일: npm run compile
# 3. 컨트랙트 테스트: npm test
# 4. 컨트랙트 배포: npm run deploy:testnet (또는 deploy:localnet / deploy:mainnet)
#
# 워크플로우:
# - 1단계: NFT 생성 (Lit Protocol로 클라이언트에서 자동 암호화 후 온체인 발행)
# - 2단계: 접근 테스트 (NFT 소유권 확인 후 복호화)
#
# =============================================================================
# ⚠️ 보안 주의사항
# =============================================================================
# - .env.local 파일은 절대 Git에 커밋하지 마세요
# - 개인키와 API 키는 안전하게 보관하세요
# - 프로덕션에서는 다른 지갑을 사용하세요
# - 테스트넷에서만 사용하세요
# =============================================================================